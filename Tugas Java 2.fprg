<?xml version="1.0"?>
<flowgorithm fileversion="3.0">
    <attributes>
        <attribute name="name" value=""/>
        <attribute name="authors" value="Dave Davin Noval A"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-20 07:22:43 AM"/>
        <attribute name="created" value="RGF2ZSBEYXZpbiBOb3ZhbCBBO0xBUFRPUC00S1NOVkY0SjsyMDI2LTA5LTE2OzExOjUzOjMxIEFNOzM5MDM="/>
        <attribute name="edited" value="RGF2ZSBEYXZpbiBOb3ZhbCBBO0xBUFRPUC00S1NOVkY0SjsyMDI2LTA5LTIwOzA3OjIyOjQzIEFNOzI7NDAxMQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="NilaiMahasiswa" type="Integer" array="False" size=""/>
            <output expression="&quot;Masukkan nilai mahasiswa&quot;" newline="True"/>
            <input variable="NilaiMahasiswa"/>
            <while expression="NilaiMahasiswa&gt;100 or NilaiMahasiswa&lt;0">
                <output expression="&quot;Nilai yang anda masukkan tidak valid&quot;" newline="True"/>
                <output expression="&quot;Masukkan nilai mahasiswa&quot;" newline="True"/>
                <input variable="NilaiMahasiswa"/>
            </while>
            <if expression="NilaiMahasiswa&gt;=85">
                <then>
                    <output expression="&quot;Predikat anda A&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="NilaiMahasiswa&gt;=70">
                        <then>
                            <output expression="&quot;Predikat anda B&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="NilaiMahasiswa&gt;=55">
                                <then>
                                    <output expression="&quot;Predikat anda C&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="NilaiMahasiswa&gt;=40">
                                        <then>
                                            <output expression="&quot;Predikat anda D&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Predikat anda E&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
